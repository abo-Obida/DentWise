# ------------------------------------------------------------
# DentWise — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` file.
# ------------------------------------------------------------

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# PostgreSQL Database (e.g. Neon, Supabase, local Postgres)
DATABASE_URL=your_postgres_connection_string

# Vapi AI Voice Agent (https://vapi.ai)
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id
# NOTE: the app code reads NEXT_PUBLIC_VAPI_API_KEY (see src/lib/vapi.ts).
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key

# Admin access — the email that unlocks the /admin dashboard
ADMIN_EMAIL=admin@example.com

# Resend Email Delivery (https://resend.com)
RESEND_API_KEY=your_resend_api_key

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
